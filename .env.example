# SoulMate AI — Environment Variables
# Copy this file to .env.local for local development

# ── App URL & Secret ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=soulmate_ai_super_secret_jwt_key_replace_in_prod_12345

# ── Database (MongoDB Atlas) ──
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/soulmate-ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/soulmate-ai

# ── AI Layer (OpenAI) ──
# Used for natural language preference extraction, match compatibility explanations, and conversational matchmaking
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Real-Time Chat (Pusher) ──
# Serverless-compatible WebSockets for Vercel/production
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key_here
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
PUSHER_APP_ID=your_pusher_app_id_here
PUSHER_SECRET=your_pusher_secret_here

# ── Media Uploads (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── SMS / OTP Service (Optional) ──
# If omitted, SoulMate AI runs in demo OTP mode (OTP = 123456 or printed in console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
